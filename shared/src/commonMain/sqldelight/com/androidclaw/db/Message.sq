CREATE TABLE Message (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    tool_name TEXT,
    tool_input TEXT,
    tool_result TEXT,
    created_at INTEGER NOT NULL,
    token_count INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(conversation_id) REFERENCES Conversation(id)
);

getMessagesForConversation:
SELECT * FROM Message WHERE conversation_id = ? ORDER BY created_at ASC;

insertMessage:
INSERT INTO Message(id, conversation_id, role, content, tool_name, tool_input, tool_result, created_at, token_count)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteMessagesForConversation:
DELETE FROM Message WHERE conversation_id = ?;

getLastMessageForConversation:
SELECT * FROM Message WHERE conversation_id = ? ORDER BY created_at DESC LIMIT 1;

getTotalMessageCount:
SELECT COUNT(*) FROM Message;

getMessageCountByRole:
SELECT role, COUNT(*) AS count FROM Message GROUP BY role;

getTotalTokenCount:
SELECT COALESCE(SUM(token_count), 0) FROM Message;

getToolUsageCounts:
SELECT tool_name, COUNT(*) AS count FROM Message WHERE tool_name IS NOT NULL GROUP BY tool_name ORDER BY count DESC;

searchMessages:
SELECT Message.*, Conversation.title AS conversation_title
FROM Message
JOIN Conversation ON Message.conversation_id = Conversation.id
WHERE Message.content LIKE '%' || ? || '%'
ORDER BY Message.created_at DESC
LIMIT 50;
