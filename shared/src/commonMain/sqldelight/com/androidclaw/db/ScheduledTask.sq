CREATE TABLE ScheduledTask (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    trigger_type TEXT NOT NULL DEFAULT 'once',
    trigger_time INTEGER NOT NULL,
    repeat_interval_ms INTEGER,
    steps TEXT NOT NULL DEFAULT '[]',
    status TEXT NOT NULL DEFAULT 'pending',
    last_run_at INTEGER,
    next_run_at INTEGER,
    result TEXT,
    failure_count INTEGER NOT NULL DEFAULT 0,
    max_retries INTEGER NOT NULL DEFAULT 3,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1
);

getAllTasks:
SELECT * FROM ScheduledTask ORDER BY next_run_at ASC;

getEnabledTasks:
SELECT * FROM ScheduledTask WHERE enabled = 1 ORDER BY next_run_at ASC;

getPendingTasks:
SELECT * FROM ScheduledTask WHERE status = 'pending' AND enabled = 1 AND next_run_at <= ? ORDER BY next_run_at ASC;

getTask:
SELECT * FROM ScheduledTask WHERE id = ?;

insertTask:
INSERT INTO ScheduledTask(id, name, description, trigger_type, trigger_time, repeat_interval_ms, steps, status, next_run_at, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?, ?);

updateStatus:
UPDATE ScheduledTask SET status = ?, last_run_at = ?, result = ?, updated_at = ? WHERE id = ?;

updateNextRun:
UPDATE ScheduledTask SET next_run_at = ?, status = 'pending', updated_at = ? WHERE id = ?;

incrementFailure:
UPDATE ScheduledTask SET failure_count = failure_count + 1, status = ?, result = ?, updated_at = ? WHERE id = ?;

enableTask:
UPDATE ScheduledTask SET enabled = ?, updated_at = ? WHERE id = ?;

deleteTask:
DELETE FROM ScheduledTask WHERE id = ?;

getTaskHistory:
SELECT * FROM ScheduledTask WHERE status IN ('done', 'failed') ORDER BY last_run_at DESC LIMIT ?;

getUpcomingTasks:
SELECT * FROM ScheduledTask WHERE enabled = 1 AND status = 'pending' AND next_run_at > ? ORDER BY next_run_at ASC LIMIT ?;
